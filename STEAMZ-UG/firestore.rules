rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'okiriae2004@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // System Permissions Collection (Managed Exclusively by okiriae2004@gmail.com)
    match /system/{docId} {
      allow read, write: if true;
    }

    // Role Assignments Collection
    match /roleAssignments/{docId} {
      allow read, write: if true;
    }

    // Health check / connection test collection
    match /test/{docId} {
      allow read: if true;
    }

    // Phone & PIN Accounts Collection (Campus WhatsApp Number + 4-Digit Secret PIN)
    match /phoneAccounts/{phoneId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read, get, list: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // Feedback Collection
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if request.resource.data.overallRating is number;
      allow update: if true;
      allow delete: if false;
    }

    // Menu Items Collection
    match /menuItems/{itemId} {
      allow read, create, update, delete: if true;
    }

    // Restaurants Collection (Publicly visible to all customers and accounts)
    match /restaurants/{restaurantId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    // Drop Spots Collection (Delivery pickup locations)
    match /dropSpots/{spotId} {
      allow read, create, update, delete: if true;
    }
  }
}
