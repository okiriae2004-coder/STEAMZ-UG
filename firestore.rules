rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'okiriae2004@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // System Permissions Collection (Managed Exclusively by okiriae2004@gmail.com)
    match /system/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isOwner(userId) 
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && (isSuperAdmin() || request.resource.data.role == 'customer');
      allow update: if (isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && (isSuperAdmin() || request.resource.data.role == resource.data.role))
        || isSuperAdmin();
      allow delete: if false;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.restaurantOwnerId == request.auth.uid
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.total is number;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.restaurantOwnerId == request.auth.uid
      );
      allow delete: if false;
    }

    // Feedback Collection
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.overallRating is number;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Menu Items Collection
    match /menuItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }
  }
}
